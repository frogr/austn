<!DOCTYPE html>
<html lang="en">
  <%# Layout for the interactive pages (pitch checker, MIDI studio, Claude Corner,
      the GPU tools when they're online) and admin. They need the app's JS and the
      older Tailwind styles. The public content pages use layouts/site. %>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% title = content_for?(:title) ? "#{content_for(:title)} · Austin French" : "Austin French · #{Profile.headline}" %>
    <% description = content_for?(:meta_description) ? content_for(:meta_description) : Profile.description %>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="https://austn.net<%= request.path %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://austn.net<%= request.path %>">
    <meta property="og:site_name" content="Austin French">
    <meta property="og:image" content="https://austn.net/og.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://austn.net/og.png">
    <meta name="robots" content="<%= request.path.start_with?("/admin") ? "noindex" : "index,follow" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

    <%= javascript_include_tag esbuild_asset_path("application.js"), type: "module", defer: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "code-theme", "data-turbo-track": "reload" %>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        background: #0e100f;
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .app-header { border-bottom: 1px solid #232825; position: relative; z-index: 100; }
      .app-header-inner {
        max-width: 64rem; margin: 0 auto; padding: 1.25rem 1.5rem;
        display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      }
      .app-wordmark { color: #e6e9e6; font-weight: 600; text-decoration: none; }
      .app-wordmark:hover { color: #4ade80; }
      .app-nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
      .app-nav a { color: #9aa39d; text-decoration: none; font-size: 0.95rem; padding: 0.35rem 0; }
      .app-nav a:hover, .app-nav a[aria-current="page"] { color: #e6e9e6; box-shadow: inset 0 -2px 0 #4ade80; }
      .app-main { position: relative; z-index: 1; min-height: 80vh; }
    </style>
  </head>

  <body>
    <header class="app-header">
      <div class="app-header-inner">
        <a class="app-wordmark" href="/">austin french</a>
        <nav class="app-nav" aria-label="Main">
          <%= link_to "Work", work_index_path %>
          <%= link_to "Writing", blog_path %>
          <%= link_to "Playground", playground_path, "aria-current": (request.path.start_with?("/admin") ? nil : "page") %>
          <%= link_to "Resume", resume_path %>
          <% if request.path.start_with?("/admin") %><%= link_to "Admin", admin_root_path, "aria-current": "page" %><% end %>
        </nav>
      </div>
    </header>

    <main class="app-main code-theme">
      <%= yield %>
    </main>
  </body>
</html>
