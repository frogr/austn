<!DOCTYPE html>
<html lang="en" class="<%= (current_palette.dark? ? current_palette : Palette.default).css_class %>">
  <%# Layout for the interactive pages (pitch checker, MIDI studio, Claude Corner,
      the GPU tools when they're online) and admin. They need the app's JS and the
      older Tailwind styles. The public content pages use layouts/site. %>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% title = content_for?(:title) ? safe_join([ content_for(:title), "Austin French" ], " · ") : "Austin French · #{Profile.headline}" %>
    <% description = content_for?(:meta_description) ? content_for(:meta_description) : Profile.description %>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="https://austn.net<%= request.path %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://austn.net<%= request.path %>">
    <meta property="og:site_name" content="Austin French">
    <meta property="og:image" content="https://austn.net/og.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://austn.net/og.png">
    <meta name="robots" content="<%= request.path.start_with?("/admin") ? "noindex" : "index,follow" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preload" href="<%= asset_path("recursive-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <%= stylesheet_link_tag "recursive", "palettes" %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

    <%= javascript_include_tag esbuild_asset_path("application.js"), type: "module", defer: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "code-theme", "data-turbo-track": "reload" %>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        background: var(--ground);
        font-family: "Recursive", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      /* Same header as layouts/site, in the visitor's palette (dark ones only: the tools are dark). */
      .app-header { position: relative; z-index: 100; background: var(--ground); }
      .app-header-inner {
        max-width: 70rem; margin: 0 auto; padding: 1rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap;
      }
      .app-mark { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--ink); text-decoration: none; }
      .app-mark-glyph {
        display: grid; place-items: center; width: 1.9rem; height: 1.9rem; padding-bottom: 0.12em;
        background: var(--clay); color: var(--ground); border-radius: 0.45rem;
        font-size: 1.25rem; font-weight: 900; line-height: 1; font-variation-settings: "CASL" 1;
        transform: rotate(-7deg); transition: transform 0.2s ease;
      }
      .app-mark:hover .app-mark-glyph { transform: rotate(7deg) scale(1.08); }
      .app-mark-name { font-weight: 750; font-size: 0.98rem; font-variation-settings: "CASL" 0.6; }
      .app-nav { display: flex; gap: 0.25rem; flex-wrap: wrap; margin-right: -0.6rem; }
      .app-nav a {
        color: var(--ink-2); text-decoration: none; font-size: 0.95rem; font-weight: 600; padding: 0.25rem 0.6rem;
        border-radius: 0.3rem; font-variation-settings: "CASL" 0.5; transition: transform 0.15s ease;
      }
      .app-nav a:hover { color: var(--ink); transform: rotate(-2deg); }
      .app-nav a[aria-current="page"] { background: var(--clay); color: var(--ground); transform: rotate(-2deg); }
      .app-main { position: relative; z-index: 1; min-height: 80vh; }
    </style>
  </head>

  <body>
    <header class="app-header">
      <div class="app-header-inner">
        <a class="app-mark" href="/" aria-label="Austin French, home">
          <span class="app-mark-glyph" aria-hidden="true">a</span>
          <span class="app-mark-name">Austin French</span>
        </a>
        <nav class="app-nav" aria-label="Main">
          <%= link_to "Work", work_index_path %>
          <%= link_to "Writing", blog_path %>
          <%= link_to "Playground", playground_path, "aria-current": (request.path.start_with?("/admin") ? nil : "page") %>
          <%= link_to "Resume", resume_path %>
          <% if request.path.start_with?("/admin") %><%= link_to "Admin", admin_root_path, "aria-current": "page" %><% end %>
        </nav>
      </div>
    </header>

    <main class="app-main code-theme">
      <%= yield %>
    </main>
  </body>
</html>
