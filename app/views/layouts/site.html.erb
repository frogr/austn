<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% title = content_for?(:title) ? "#{content_for(:title)} · Austin French" : "Austin French · #{Profile.headline}" %>
    <% description = content_for?(:meta_description) ? content_for(:meta_description) : Profile.description %>
    <% canonical = "https://austn.net#{request.path == "/" ? "/" : request.path}" %>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonical %>">

    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? content_for(:og_type) : "website" %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:site_name" content="Austin French">
    <meta property="og:image" content="https://austn.net/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="https://austn.net/og.png">

    <script type="application/ld+json"><%= raw Profile.json_ld.to_json %></script>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400&display=swap">

    <%= stylesheet_link_tag "site" %>
    <% if content_for?(:javascript) %>
      <%= javascript_include_tag esbuild_asset_path("application.js"), type: "module", defer: true %>
    <% end %>
    <%= yield :head %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">austin french</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            <% [ [ "Work", work_index_path ], [ "Writing", blog_path ], [ "Playground", playground_path ], [ "Resume", resume_path ] ].each do |label, path| %>
              <li><%= link_to label, path, "aria-current": (current_section == label.downcase ? "page" : nil) %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="<%= content_for?(:wide) ? "wrap wrap--wide" : "wrap" %>">
        <% if notice.present? %><p class="flash flash--notice"><%= notice %></p><% end %>
        <% if alert.present? %><p class="flash flash--alert"><%= alert %></p><% end %>
        <%= yield %>
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul>
          <li><%= mail_to Profile.email %></li>
          <li><%= link_to "GitHub", Profile.links["github"] %></li>
          <li><%= link_to "LinkedIn", Profile.links["linkedin"] %></li>
          <li><%= link_to "Book a time", meet_path %></li>
          <li><%= link_to "Now", now_path %></li>
        </ul>
        <a class="admin-link" href="<%= admin_root_path %>" aria-label="Admin" title="Admin">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
        </a>
      </div>
    </footer>
  </body>
</html>
