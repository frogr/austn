<%# A short ranked list drawn as bars. rows: [[label, count], ...] %>
<% max = rows.map(&:last).max.to_i %>
<div class="p-4 rounded-lg" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
  <h3 class="text-white font-semibold mb-3"><%= title %></h3>
  <% if rows.empty? %>
    <p class="text-gray-500 text-sm"><%= empty %></p>
  <% else %>
    <ol class="space-y-1.5 text-sm">
      <% rows.each do |label, count| %>
        <li class="relative px-2 py-1 rounded overflow-hidden">
          <span class="absolute inset-y-0 left-0 rounded" style="width: <%= bar_width(count, max) %>; background: rgba(29, 185, 84, 0.18);"></span>
          <span class="relative flex justify-between gap-3">
            <span class="text-gray-200 truncate"><%= label %></span>
            <span class="text-gray-400 tabular-nums"><%= count %></span>
          </span>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
