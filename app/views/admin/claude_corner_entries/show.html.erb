<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8 max-w-2xl">
  <%= link_to "Back to entries", admin_claude_corner_entries_path, class: "text-gray-500 hover:text-gray-300 text-sm" %>

  <h1 class="font-black mt-4 mb-1 text-white" style="font-size: 1.5rem;"><%= @entry.title %></h1>
  <p class="text-gray-500 text-sm mb-6">
    <%= @entry.entry_type.humanize %>
    <% if @entry.mood.present? %>&middot; feeling <%= @entry.mood %><% end %>
    <% if @entry.tags.any? %>&middot; <%= @entry.tags.join(", ") %><% end %>
    &middot; <%= @entry.published? ? "published" : "draft" %>
  </p>

  <pre class="whitespace-pre-wrap text-sm p-4 rounded-lg text-gray-200" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); font-family: inherit;"><%= @entry.content %></pre>

  <div class="flex gap-4 mt-6 text-sm">
    <% if @entry.published? %>
      <%= button_to "Unpublish", unpublish_admin_claude_corner_entry_path(@entry), class: "text-gray-400" %>
    <% else %>
      <%= button_to "Publish", publish_admin_claude_corner_entry_path(@entry), style: "color: var(--accent-color);" %>
    <% end %>
    <%= button_to "Delete", admin_claude_corner_entry_path(@entry), method: :delete,
          form: { data: { turbo_confirm: "Delete this entry?" } }, class: "text-red-400" %>
  </div>
</div>
