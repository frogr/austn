<% page_title @item.title %>
<% page_description @item.summary %>
<% content_for :og_type, "article" %>
<% content_for :wide, true %>

<%= link_to "← All work", work_index_path, class: "back" %>

<%# The article is a grid: everything in the reading column except the facts,
    which sit in the rail on the right. On phones the rail follows the lede. %>
<article class="page-grid">
  <h1><%= @item.title %></h1>
  <p class="lede"><%= @item.summary %></p>

  <aside class="rail">
    <% if @item.art? %><span class="toy-art" data-hue="<%= @item.hue %>" aria-hidden="true"><%= render "shared/toy_art", slug: @item.slug %></span><% end %>
    <dl class="facts">
      <% if @item.role %><dt>role</dt><dd><%= @item.role %></dd><% end %>
      <% if @item.timeframe %><dt>when</dt><dd><%= @item.timeframe %></dd><% end %>
      <% if @item.stack.any? %><dt>stack</dt><dd><%= @item.stack.join(", ") %></dd><% end %>
      <% if @item.links.any? %>
        <dt>links</dt>
        <dd><%= safe_join(@item.links.map { |l| link_to(l["label"], l["url"]) }, tag.br) %></dd>
      <% end %>
    </dl>
  </aside>

  <% if @item.stats.any? %>
    <ul class="stats">
      <% @item.stats.each_with_index do |stat, index| %>
        <li style="--i: <%= index %>"><strong><%= stat["value"] %></strong> <span><%= stat["label"] %></span></li>
      <% end %>
    </ul>
  <% end %>

  <div class="prose">
    <%= markdown(@item.body) %>
  </div>

  <% if (offer = @item.offer) %>
    <%# The project is the worked sample for one of the offers on /hire. %>
    <aside class="note proof-note" aria-label="Hire me to build one">
      <p><strong>Want one of these for your own data?</strong> This project is the sample behind my <%= link_to offer.title, hire_path(anchor: offer.slug) %> offer, <%= offer.short_price %>. You get a written scope, tests and the numbers before anything ships.</p>
      <%= link_to "See the offer", hire_path(anchor: offer.slug), class: "button button--small" %>
    </aside>
  <% end %>
</article>

<nav class="pager" aria-label="More work">
  <span><% if @previous_item %><%= link_to "← #{@previous_item.title}", work_item_path(@previous_item) %><% end %></span>
  <span><% if @next_item %><%= link_to "#{@next_item.title} →", work_item_path(@next_item) %><% end %></span>
</nav>
