<%# Small drawings for tiles, drawn in the tile's ink colour and animated in site.css.
    pathLength="100" on a path lets .art-draw and .art-circle draw it without knowing its real length. %>
<% case slug %>
<% when "pitch-checker" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-soft" d="M22.3 59.6 A46 46 0 0 1 97.7 59.6"/>
    <path class="art-stroke" d="M60 40 V48 M80.9 45 L77.3 52.1 M39.1 45 L42.7 52.1 M97.7 59.6 L91.1 64.2 M22.3 59.6 L28.9 64.2"/>
    <path class="art-stroke art-needle" d="M60 86 V46"/>
    <circle class="art-fill" cx="60" cy="86" r="6"/>
    <path class="art-stroke art-thin" d="M30 104 H90"/>
  </svg>
<% when "midi-studio" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke art-thin" x="12" y="22" width="14" height="78" rx="3"/>
    <path class="art-fill" d="M12 35h9v8h-9z M12 61h9v8h-9z M12 79h9v8h-9z"/>
    <g class="art-fill">
      <rect x="34" y="26" width="22" height="9" rx="3"/>
      <rect x="60" y="39" width="14" height="9" rx="3"/>
      <rect x="78" y="52" width="26" height="9" rx="3"/>
      <rect x="40" y="65" width="18" height="9" rx="3"/>
      <rect x="62" y="78" width="30" height="9" rx="3"/>
      <rect x="34" y="91" width="12" height="9" rx="3"/>
    </g>
    <path class="art-stroke art-thin art-playhead" d="M32 18 V104"/>
  </svg>
<% when "claude-corner" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-thin art-soft" d="M24 84 L44 58 L66 68 L84 40 L100 52 M44 58 L38 30"/>
    <circle class="art-fill art-star" cx="24" cy="84" r="4"/>
    <circle class="art-fill art-star" cx="44" cy="58" r="5"/>
    <circle class="art-fill art-star" cx="66" cy="68" r="4"/>
    <circle class="art-fill art-star" cx="84" cy="40" r="5"/>
    <circle class="art-fill art-star" cx="100" cy="52" r="3.5"/>
    <circle class="art-fill art-star" cx="38" cy="30" r="3.5"/>
    <path class="art-fill art-star" d="M88 76 Q90 86 100 88 Q90 90 88 100 Q86 90 76 88 Q86 86 88 76Z"/>
  </svg>
<% when "book-a-call" %>
  <%# A calendar page with one day getting circled. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke" x="18" y="28" width="84" height="74" rx="9"/>
    <path class="art-stroke" d="M18 46 H102 M40 20 V34 M80 20 V34"/>
    <g class="art-fill art-soft">
      <rect x="29" y="55" width="9" height="9" rx="2"/><rect x="47" y="55" width="9" height="9" rx="2"/><rect x="65" y="55" width="9" height="9" rx="2"/><rect x="83" y="55" width="9" height="9" rx="2"/>
      <rect x="29" y="70" width="9" height="9" rx="2"/><rect x="47" y="70" width="9" height="9" rx="2"/><rect x="83" y="70" width="9" height="9" rx="2"/>
      <rect x="29" y="85" width="9" height="9" rx="2"/><rect x="47" y="85" width="9" height="9" rx="2"/><rect x="65" y="85" width="9" height="9" rx="2"/>
    </g>
    <rect class="art-fill" x="65" y="70" width="9" height="9" rx="2"/>
    <path class="art-stroke art-circle" pathLength="100" d="M70 61 C79 60 84 67 83 75 C82 84 74 89 66 87 C58 85 55 77 58 69 C60 63 66 60 74 62"/>
  </svg>
<% when "image-generation" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke" x="20" y="24" width="80" height="72" rx="9"/>
    <circle class="art-fill art-star" cx="78" cy="46" r="8"/>
    <path class="art-stroke art-draw" pathLength="100" d="M26 88 L48 58 L62 74 L74 62 L94 88"/>
  </svg>
<% when "music-generation" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-fill art-bar" x="22" y="46" width="11" height="52" rx="5"/>
    <rect class="art-fill art-bar" x="39" y="26" width="11" height="72" rx="5"/>
    <rect class="art-fill art-bar" x="56" y="40" width="11" height="58" rx="5"/>
    <rect class="art-fill art-bar" x="73" y="22" width="11" height="76" rx="5"/>
    <rect class="art-fill art-bar" x="90" y="52" width="11" height="46" rx="5"/>
  </svg>
<% when "text-to-speech" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M26 24 H94 a9 9 0 0 1 9 9 V71 a9 9 0 0 1 -9 9 H58 L42 98 V80 H26 a9 9 0 0 1 -9 -9 V33 a9 9 0 0 1 9 -9 Z"/>
    <rect class="art-fill art-bar art-bar--mid" x="34" y="42" width="7" height="20" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="47" y="36" width="7" height="32" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="60" y="44" width="7" height="16" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="73" y="34" width="7" height="36" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="86" y="45" width="7" height="14" rx="3.5"/>
  </svg>
<% when "stem-separation" %>
  <%# One song, four tracks moving at their own speeds. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-slide" d="M18 32 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 51 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 70 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 89 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
  </svg>
<% when "background-removal" %>
  <%# A person, and a checkerboard where the background used to be. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft">
      <rect class="art-star" x="20" y="20" width="20" height="20"/><rect class="art-star" x="60" y="20" width="20" height="20"/>
      <rect class="art-star" x="40" y="40" width="20" height="20"/><rect class="art-star" x="80" y="40" width="20" height="20"/>
      <rect class="art-star" x="20" y="60" width="20" height="20"/><rect class="art-star" x="60" y="60" width="20" height="20"/>
      <rect class="art-star" x="40" y="80" width="20" height="20"/><rect class="art-star" x="80" y="80" width="20" height="20"/>
    </g>
    <circle class="art-fill" cx="60" cy="50" r="13"/>
    <path class="art-fill" d="M34 100 q0 -30 26 -30 q26 0 26 30 Z"/>
  </svg>
<% when "image-to-svg" %>
  <%# A curve being traced between two anchor points. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-thin art-soft" d="M24 90 L46 44 M96 34 L74 82"/>
    <circle class="art-fill art-soft" cx="46" cy="44" r="5"/><circle class="art-fill art-soft" cx="74" cy="82" r="5"/>
    <path class="art-stroke art-draw" pathLength="100" d="M24 90 C46 44 74 82 96 34"/>
    <rect class="art-fill" x="17" y="83" width="14" height="14" rx="2"/><rect class="art-fill" x="89" y="27" width="14" height="14" rx="2"/>
  </svg>
<% when "image-to-3d" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-tumble">
      <path class="art-stroke" d="M60 24 L94 43 L60 62 L26 43 Z"/>
      <path class="art-stroke" d="M26 43 V79 L60 98 L94 79 V43 M60 62 V98"/>
    </g>
  </svg>
<% when "marginalia" %>
  <%# An open book, and a magnifying glass finding a line in it. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M12 30 Q36 20 60 32 V98 Q36 86 12 96 Z"/>
    <path class="art-stroke" d="M108 30 Q84 20 60 32 V98 Q84 86 108 96 Z"/>
    <path class="art-stroke art-soft" d="M24 48 H48 M24 60 H48 M24 72 H48 M72 48 H96 M72 72 H96"/>
    <path class="art-stroke" d="M72 60 H96"/>
    <circle class="art-fill art-soft art-star" cx="84" cy="60" r="13"/>
    <circle class="art-stroke" cx="84" cy="60" r="17"/>
    <path class="art-stroke" d="M96 72 L110 86" stroke-width="5"/>
  </svg>
<% when "gutenberg-mcp" %>
  <%# A quotation, and the check that says it really is in the book. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-fill" d="M38 34 a9 9 0 1 1 -9 9 c0 10 -6 16 -14 18 v-6 c4 -2 7 -5 8 -10 a9 9 0 0 1 15 -11z"/>
    <path class="art-fill" d="M70 34 a9 9 0 1 1 -9 9 c0 10 -6 16 -14 18 v-6 c4 -2 7 -5 8 -10 a9 9 0 0 1 15 -11z"/>
    <path class="art-stroke" d="M22 76 H74 M22 92 H60"/>
    <path class="art-stroke art-draw" pathLength="100" d="M74 94 L88 108 L112 78" stroke-width="5"/>
  </svg>
<% when "lichess-mcp" %>
  <%# A pawn on the board. The move the engine liked draws itself in; the move played fades behind it. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft">
      <rect x="14" y="16" width="30" height="30"/><rect x="74" y="16" width="30" height="30"/>
      <rect x="44" y="46" width="30" height="30"/>
      <rect x="14" y="76" width="30" height="30"/><rect x="74" y="76" width="30" height="30"/>
    </g>
    <rect class="art-stroke" x="14" y="16" width="90" height="90" rx="3"/>
    <circle class="art-fill" cx="29" cy="76" r="9"/>
    <path class="art-fill" d="M23 84 h12 l4 12 h-20z"/>
    <rect class="art-fill" x="16" y="96" width="26" height="6" rx="2"/>
    <path class="art-stroke art-slide art-soft" d="M46 88 H90" stroke-width="4"/>
    <path class="art-stroke art-draw" pathLength="100" d="M44 70 L82 32 M64 32 H84 V52" stroke-width="4"/>
  </svg>
<% when "coach-rook" %>
  <%# A rook on the board and the coach's speech bubble, which pops in as it talks. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft">
      <rect x="14" y="46" width="30" height="30"/><rect x="74" y="46" width="30" height="30"/>
      <rect x="44" y="76" width="30" height="30"/>
    </g>
    <rect class="art-stroke" x="14" y="46" width="90" height="60" rx="3"/>
    <path class="art-fill" d="M46 56 h6 v6 h4 v-6 h8 v6 h4 v-6 h6 v12 h-28z"/>
    <path class="art-fill" d="M50 68 h20 v20 h-20z"/>
    <rect class="art-fill" x="44" y="88" width="32" height="6" rx="2"/>
    <g class="art-pop">
      <path class="art-stroke" d="M64 12 h40 a6 6 0 0 1 6 6 v14 a6 6 0 0 1 -6 6 h-26 l-10 8 v-8 h-4 a6 6 0 0 1 -6 -6 v-14 a6 6 0 0 1 6 -6z"/>
      <path class="art-stroke art-thin" d="M72 22 H98 M72 29 H90"/>
    </g>
  </svg>
<% when "nyc-open-data-mcp" %>
  <%# A map pin on the city grid. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-soft" d="M14 34 H106 M14 60 H106 M14 86 H106 M34 14 V106 M60 14 V106 M86 14 V106"/>
    <g class="art-bob">
      <path class="art-fill" d="M60 20 a22 22 0 0 1 22 22 c0 16 -22 42 -22 42 s-22 -26 -22 -42 a22 22 0 0 1 22 -22z"/>
      <circle class="art-stroke" cx="60" cy="42" r="8" style="stroke: var(--hue, currentColor);"/>
    </g>
    <ellipse class="art-fill art-soft" cx="60" cy="92" rx="14" ry="4"/>
  </svg>
<% when "second-draft" %>
  <%# A pencil striking one line and writing the next. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-soft" d="M16 32 H84 M16 86 H60"/>
    <path class="art-stroke" d="M16 50 H74"/>
    <path class="art-stroke art-draw" pathLength="100" d="M12 52 Q30 44 48 51 T80 49"/>
    <path class="art-stroke art-draw" pathLength="100" d="M16 68 H62"/>
    <g class="art-tumble">
      <path class="art-fill" d="M62 68 L72 58 L104 90 L94 100z"/>
      <path class="art-fill art-soft" d="M62 68 L72 58 L78 64 L68 74z"/>
      <path class="art-stroke" d="M94 100 L104 90 L110 104z"/>
    </g>
  </svg>
<% when "llm-eval-starter" %>
  <%# A golden set: two cases pass, one fails, and the gate holds. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke" x="16" y="18" width="22" height="22" rx="5"/>
    <rect class="art-stroke" x="16" y="50" width="22" height="22" rx="5"/>
    <rect class="art-stroke" x="16" y="82" width="22" height="22" rx="5"/>
    <path class="art-stroke art-soft" d="M50 29 H104 M50 61 H92 M50 93 H100"/>
    <path class="art-stroke art-draw" pathLength="100" d="M20 30 L26 36 L36 22"/>
    <path class="art-stroke art-draw" pathLength="100" d="M20 62 L26 68 L36 54"/>
    <path class="art-stroke" d="M21 87 L33 99 M33 87 L21 99"/>
  </svg>
<% when "chat" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M22 22 H70 a8 8 0 0 1 8 8 V46 a8 8 0 0 1 -8 8 H38 L26 66 V54 H22 a8 8 0 0 1 -8 -8 V30 a8 8 0 0 1 8 -8 Z"/>
    <path class="art-fill" d="M50 64 H98 a8 8 0 0 1 8 8 V88 a8 8 0 0 1 -8 8 H94 V108 L82 96 H50 a8 8 0 0 1 -8 -8 V72 a8 8 0 0 1 8 -8 Z"/>
    <circle class="art-hue art-bob" cx="60" cy="80" r="4.5"/><circle class="art-hue art-bob" cx="74" cy="80" r="4.5"/><circle class="art-hue art-bob" cx="88" cy="80" r="4.5"/>
  </svg>
<% end %>
