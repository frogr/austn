  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke" x="18" y="28" width="84" height="74" rx="9"/>
    <path class="art-stroke" d="M18 46 H102 M40 20 V34 M80 20 V34"/>
    <g class="art-fill art-soft">
      <rect x="29" y="55" width="9" height="9" rx="2"/><rect x="47" y="55" width="9" height="9" rx="2"/><rect x="65" y="55" width="9" height="9" rx="2"/><rect x="83" y="55" width="9" height="9" rx="2"/>
      <rect x="29" y="70" width="9" height="9" rx="2"/><rect x="47" y="70" width="9" height="9" rx="2"/><rect x="83" y="70" width="9" height="9" rx="2"/>
      <rect x="29" y="85" width="9" height="9" rx="2"/><rect x="47" y="85" width="9" height="9" rx="2"/><rect x="65" y="85" width="9" height="9" rx="2"/>
    </g>
    <rect class="art-fill" x="65" y="70" width="9" height="9" rx="2"/>
    <path class="art-stroke art-circle" pathLength="100" d="M70 61 C79 60 84 67 83 75 C82 84 74 89 66 87 C58 85 55 77 58 69 C60 63 66 60 74 62"/>
  </svg>
<% when "image-generation" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke" x="20" y="24" width="80" height="72" rx="9"/>
    <circle class="art-fill art-star" cx="78" cy="46" r="8"/>
    <path class="art-stroke art-draw" pathLength="100" d="M26 88 L48 58 L62 74 L74 62 L94 88"/>
  </svg>
<% when "music-generation" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-fill art-bar" x="22" y="46" width="11" height="52" rx="5"/>
    <rect class="art-fill art-bar" x="39" y="26" width="11" height="72" rx="5"/>
    <rect class="art-fill art-bar" x="56" y="40" width="11" height="58" rx="5"/>
    <rect class="art-fill art-bar" x="73" y="22" width="11" height="76" rx="5"/>
    <rect class="art-fill art-bar" x="90" y="52" width="11" height="46" rx="5"/>
  </svg>
<% when "text-to-speech" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M26 24 H94 a9 9 0 0 1 9 9 V71 a9 9 0 0 1 -9 9 H58 L42 98 V80 H26 a9 9 0 0 1 -9 -9 V33 a9 9 0 0 1 9 -9 Z"/>
    <rect class="art-fill art-bar art-bar--mid" x="34" y="42" width="7" height="20" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="47" y="36" width="7" height="32" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="60" y="44" width="7" height="16" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="73" y="34" width="7" height="36" rx="3.5"/>
    <rect class="art-fill art-bar art-bar--mid" x="86" y="45" width="7" height="14" rx="3.5"/>
  </svg>
<% when "stem-separation" %>
  <%# One song, four tracks moving at their own speeds. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-slide" d="M18 32 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 51 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 70 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
    <path class="art-stroke art-slide" d="M18 89 q10.5 -11 21 0 t21 0 t21 0 t21 0"/>
  </svg>
<% when "background-removal" %>
  <%# A person, and a checkerboard where the background used to be. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft">
      <rect class="art-star" x="20" y="20" width="20" height="20"/><rect class="art-star" x="60" y="20" width="20" height="20"/>
      <rect class="art-star" x="40" y="40" width="20" height="20"/><rect class="art-star" x="80" y="40" width="20" height="20"/>
      <rect class="art-star" x="20" y="60" width="20" height="20"/><rect class="art-star" x="60" y="60" width="20" height="20"/>
      <rect class="art-star" x="40" y="80" width="20" height="20"/><rect class="art-star" x="80" y="80" width="20" height="20"/>
    </g>
    <circle class="art-fill" cx="60" cy="50" r="13"/>
    <path class="art-fill" d="M34 100 q0 -30 26 -30 q26 0 26 30 Z"/>
  </svg>
<% when "image-to-svg" %>
  <%# A curve being traced between two anchor points. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-thin art-soft" d="M24 90 L46 44 M96 34 L74 82"/>
    <circle class="art-fill art-soft" cx="46" cy="44" r="5"/><circle class="art-fill art-soft" cx="74" cy="82" r="5"/>
    <path class="art-stroke art-draw" pathLength="100" d="M24 90 C46 44 74 82 96 34"/>
    <rect class="art-fill" x="17" y="83" width="14" height="14" rx="2"/><rect class="art-fill" x="89" y="27" width="14" height="14" rx="2"/>
  </svg>
<% when "image-to-3d" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-tumble">
      <path class="art-stroke" d="M60 24 L94 43 L60 62 L26 43 Z"/>
      <path class="art-stroke" d="M26 43 V79 L60 98 L94 79 V43 M60 62 V98"/>
    </g>
  </svg>
<% when "marginalia" %>
  <%# An open book. One line gets found and checked. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M14 30 Q37 22 60 32 V96 Q37 86 14 94 Z M106 30 Q83 22 60 32 V96 Q83 86 106 94 Z"/>
    <path class="art-stroke art-thin art-soft" d="M24 46 H50 M24 56 H50 M24 76 H50 M70 46 H96 M70 56 H96 M70 66 H96 M70 76 H96"/>
    <path class="art-stroke art-thin" d="M24 66 H50"/>
    <rect class="art-fill art-soft" x="22" y="61" width="30" height="9" rx="3"/>
    <path class="art-stroke art-draw" pathLength="100" d="M74 94 L82 102 L98 84"/>
  </svg>
<% when "gutenberg-mcp" %>
  <%# Numbered lines of a book, a quotation mark, and a bar scanning down to find the quote. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft"><rect x="20" y="30" width="7" height="4" rx="2"/><rect x="20" y="46" width="7" height="4" rx="2"/><rect x="20" y="62" width="7" height="4" rx="2"/><rect x="20" y="78" width="7" height="4" rx="2"/><rect x="20" y="94" width="7" height="4" rx="2"/></g>
    <path class="art-stroke art-thin art-soft" d="M34 32 H92 M34 48 H80 M34 64 H96 M34 80 H74 M34 96 H88"/>
    <rect class="art-fill art-soft art-scan" x="16" y="24" width="88" height="16" rx="4"/>
    <path class="art-fill" d="M70 10 q-6 0 -8 6 q-1 4 2 7 q3 3 7 1 q0 5 -5 8 q6 -1 9 -7 q2 -5 -1 -11 q-2 -4 -4 -4z M86 10 q-6 0 -8 6 q-1 4 2 7 q3 3 7 1 q0 5 -5 8 q6 -1 9 -7 q2 -5 -1 -11 q-2 -4 -4 -4z"/>
    <path class="art-stroke art-draw" pathLength="100" d="M86 102 L94 110 L110 92"/>
  </svg>
<% when "lichess-mcp" %>
  <%# A corner of a board. The dashed arrow is the move played; the solid one, drawn in, is the move the engine liked. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <g class="art-fill art-soft">
      <rect x="16" y="24" width="20" height="20"/><rect x="56" y="24" width="20" height="20"/>
      <rect x="36" y="44" width="20" height="20"/><rect x="76" y="44" width="20" height="20"/>
      <rect x="16" y="64" width="20" height="20"/><rect x="56" y="64" width="20" height="20"/>
      <rect x="36" y="84" width="20" height="20"/><rect x="76" y="84" width="20" height="20"/>
    </g>
    <rect class="art-stroke art-thin" x="16" y="24" width="80" height="80" rx="2"/>
    <path class="art-fill" d="M38 76 c0 -8 6 -12 12 -12 l2 -6 l4 4 c4 1 6 4 6 9 c0 5 -3 8 -6 10 c6 6 6 12 2 14 h-24 c-4 -2 -3 -8 4 -14 c-4 -2 -5 -4 0 -5z"/>
    <path class="art-stroke art-thin art-slide" d="M46 56 L82 32"/>
    <path class="art-stroke art-draw" pathLength="100" d="M46 56 L76 70 M68 72 L76 70 L74 62"/>
    <path class="art-stroke art-thin" d="M98 12 h12 a4 4 0 0 1 4 4 v8 a4 4 0 0 1 -4 4 h-6 l-4 4 v-4 h-2 a4 4 0 0 1 -4 -4 v-8 a4 4 0 0 1 4 -4z"/>
  </svg>
<% when "nyc-open-data-mcp" %>
  <%# A skyline, and the city's numbers rising out of it. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-thin art-soft" d="M12 104 V72 H28 V58 H40 V80 H52 V40 H66 V64 H78 V50 H92 V76 H108 V104"/>
    <path class="art-stroke art-thin" d="M8 104 H112"/>
    <rect class="art-fill art-bar" x="30" y="66" width="12" height="38" rx="3"/>
    <rect class="art-fill art-bar" x="54" y="46" width="12" height="58" rx="3"/>
    <rect class="art-fill art-bar" x="78" y="56" width="12" height="48" rx="3"/>
    <path class="art-fill art-pop" d="M96 14 a9 9 0 0 1 9 9 c0 7 -9 17 -9 17 s-9 -10 -9 -17 a9 9 0 0 1 9 -9z"/>
    <circle class="art-fill art-star" cx="22" cy="22" r="3"/>
  </svg>
<% when "second-draft" %>
  <%# A paragraph. One sentence is struck out and its replacement is being written. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke art-thin art-soft" d="M18 30 H96 M18 44 H88 M18 86 H92 M18 100 H70"/>
    <path class="art-stroke art-thin" d="M18 58 H84"/>
    <path class="art-stroke" d="M14 58 L88 58" stroke-dasharray="0" opacity="0"/>
    <path class="art-stroke art-draw" pathLength="100" d="M12 60 Q50 52 90 59"/>
    <path class="art-stroke art-draw" pathLength="100" d="M18 72 H64"/>
    <path class="art-fill" d="M92 12 v22 h4 v-22 h3 v-4 h-13 a6 6 0 0 0 0 12 v14 h4 v-22z"/>
  </svg>
<% when "llm-eval-starter" %>
  <%# A golden set: three cases, two pass, one fails, and the gate at the bottom. %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <rect class="art-stroke art-thin" x="18" y="18" width="16" height="16" rx="4"/>
    <rect class="art-stroke art-thin" x="18" y="46" width="16" height="16" rx="4"/>
    <rect class="art-stroke art-thin" x="18" y="74" width="16" height="16" rx="4"/>
    <path class="art-stroke art-thin art-soft" d="M44 26 H98 M44 54 H86 M44 82 H94"/>
    <path class="art-stroke art-draw" pathLength="100" d="M21 26 L25 30 L32 21"/>
    <path class="art-stroke art-draw" pathLength="100" d="M21 54 L25 58 L32 49"/>
    <path class="art-stroke" d="M22 78 L30 86 M30 78 L22 86"/>
    <rect class="art-fill art-soft" x="18" y="100" width="84" height="6" rx="3"/>
    <rect class="art-fill art-bar art-bar--mid" x="18" y="100" width="58" height="6" rx="3" style="transform-origin: left center;"/>
  </svg>
<% when "chat" %>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path class="art-stroke" d="M22 22 H70 a8 8 0 0 1 8 8 V46 a8 8 0 0 1 -8 8 H38 L26 66 V54 H22 a8 8 0 0 1 -8 -8 V30 a8 8 0 0 1 8 -8 Z"/>
    <path class="art-fill" d="M50 64 H98 a8 8 0 0 1 8 8 V88 a8 8 0 0 1 -8 8 H94 V108 L82 96 H50 a8 8 0 0 1 -8 -8 V72 a8 8 0 0 1 8 -8 Z"/>
    <circle class="art-hue art-bob" cx="60" cy="80" r="4.5"/><circle class="art-hue art-bob" cx="74" cy="80" r="4.5"/><circle class="art-hue art-bob" cx="88" cy="80" r="4.5"/>
  </svg>
<% end %>
