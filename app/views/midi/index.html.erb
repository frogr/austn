<% meta_title("MIDI studio") %>
<% meta_description("A small music workstation in the browser: piano roll, synths, drums, effects and WAV export.") %>

<div class="w-full px-2 sm:px-4 py-2 sm:py-4">
  <div style="max-width: 70rem; margin: 0 auto 0.75rem; padding: 0 0.5rem;">
    <h1 style="font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; font-variation-settings: 'CASL' 1; letter-spacing: -0.02em; margin: 0; color: var(--ink);">MIDI studio</h1>
    <p style="margin: 0.25rem 0 0; color: var(--ink-2);">Draw notes on the piano roll, pick a synth, press play. Everything runs in your browser.</p>
  </div>

  <div data-react-component="DAW" data-props="{}"></div>
</div>
