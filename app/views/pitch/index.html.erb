<% content_for(:title) { "Pitch checker" } %>
<% content_for(:meta_description) { "Real-time pitch detection tool. Sing along to reference tracks, tune your guitar, and see your pitch on a scrolling piano roll with cents accuracy." } %>

<div class="pitch-page" data-controller="pitch-detector">

  <%# Header %>
  <div class="pitch-header">
    <h1 class="pitch-title">Pitch checker</h1>
    <p class="pitch-subtitle">Real-time pitch detection for voice &amp; guitar</p>
  </div>

  <%# Start button %>
  <div class="pitch-start-container" data-pitch-detector-target="startBtn">
    <button class="pitch-start-btn" data-action="click->pitch-detector#start">
      <span class="material-icons" aria-hidden="true">mic</span>
      Enable Microphone
    </button>
    <p class="pitch-start-hint">Audio stays on your device. Nothing is sent to a server.</p>
  </div>

  <%# Status %>
  <div class="pitch-status" data-pitch-detector-target="status"></div>

  <%# Info bar: note + cents + level %>
  <div class="pitch-info-bar glass">
    <div class="pitch-info-note">
      <div class="pitch-note-display" data-pitch-detector-target="noteDisplay">--</div>
      <div class="pitch-freq-display" data-pitch-detector-target="freqDisplay">-- Hz</div>
    </div>

    <div class="pitch-info-cents">
      <div class="pitch-cents-track" data-pitch-detector-target="centsGauge">
        <div class="pitch-cents-labels">
          <span>-50</span><span>-25</span><span class="pitch-cents-center-label">0</span><span>+25</span><span>+50</span>
        </div>
        <div class="pitch-cents-bar">
          <div class="pitch-cents-zone-green"></div>
          <div class="pitch-cents-needle" data-pitch-detector-target="centsNeedle"></div>
        </div>
      </div>
      <div class="pitch-cents-value" data-pitch-detector-target="centsValue">0c</div>
    </div>

    <div class="pitch-info-level">
      <span class="material-icons pitch-level-icon" aria-hidden="true">graphic_eq</span>
      <div class="pitch-level-meter" data-pitch-detector-target="levelMeter">
        <div class="pitch-level-fill" data-pitch-detector-target="levelFill"></div>
      </div>
    </div>

    <%# Guitar info (hidden in chromatic mode) %>
    <div class="pitch-guitar-info" data-pitch-detector-target="guitarInfo" style="display: none;">
      <span class="guitar-string-badge">--</span>
      <span class="guitar-cents">--</span>
    </div>
  </div>

  <%# Main grid: vertical piano keys + scrolling canvas %>
  <div class="pitch-grid-section glass">
    <div class="pitch-grid-header">
      <div class="pitch-grid-legend">
        <span class="pitch-legend-dot pitch-legend-live"></span> Your pitch
        <span class="pitch-legend-dot pitch-legend-ref"></span> Reference
      </div>
      <span class="pitch-grid-hint">Click piano keys for reference tones</span>
    </div>
    <div class="pitch-grid-container">
      <div class="pitch-piano-keys" data-pitch-detector-target="pianoKeys">
        <%# Built dynamically by Stimulus %>
      </div>
      <div class="pitch-canvas-wrap">
        <canvas class="pitch-grid-canvas" data-pitch-detector-target="gridCanvas"></canvas>
      </div>
    </div>
  </div>

  <%# Controls %>
  <div class="pitch-controls glass">
    <%# Mode toggle %>
    <div class="pitch-control-group">
      <label class="pitch-control-label">Mode</label>
      <button class="pitch-mode-toggle" data-pitch-detector-target="modeToggle"
              data-action="click->pitch-detector#toggleMode" role="switch" aria-checked="false">
        <span class="pitch-mode-option">Chromatic</span>
        <span class="pitch-mode-option">Guitar</span>
        <span class="pitch-mode-slider"></span>
      </button>
      <span class="pitch-mode-label" data-pitch-detector-target="modeLabel">Chromatic</span>
    </div>

    <%# Noise gate %>
    <div class="pitch-control-group">
      <label class="pitch-control-label">
        Noise Gate
        <span class="pitch-gate-val" data-pitch-detector-target="noiseGateValue">1.5</span>
      </label>
      <input type="range" class="pitch-slider" aria-label="Noise gate" min="0.002" max="0.1" step="0.002" value="0.015"
             data-pitch-detector-target="noiseGate"
             data-action="input->pitch-detector#updateNoiseGate">
    </div>

    <%# Reference audio %>
    <div class="pitch-control-group pitch-ref-group">
      <label class="pitch-control-label">Reference Track</label>
      <input type="file" accept="audio/*" class="pitch-ref-file-input"
             data-pitch-detector-target="refFileInput"
             data-action="change->pitch-detector#handleRefFile"
             style="display: none;">
      <div class="pitch-ref-controls">
        <button class="pitch-ref-btn btn-secondary" data-action="click->pitch-detector#loadReference">
          <span class="material-icons" aria-hidden="true">upload_file</span> Load Audio
        </button>
        <button class="pitch-ref-btn btn-primary" data-pitch-detector-target="refPlayBtn"
                data-action="click->pitch-detector#playRef" style="display: none;">
          <span class="material-icons" aria-hidden="true">play_arrow</span> Play
        </button>
        <button class="pitch-ref-btn pitch-ref-stop-btn" data-pitch-detector-target="refStopBtn"
                data-action="click->pitch-detector#stopRef" style="display: none;">
          <span class="material-icons" aria-hidden="true">stop</span> Stop
        </button>
        <button class="pitch-ref-clear-btn" data-action="click->pitch-detector#clearRef"
                data-pitch-detector-target="refClearBtn" style="display: none;" title="Remove reference" aria-label="Remove reference track">
          <span class="material-icons" aria-hidden="true">close</span>
        </button>
      </div>
      <span class="pitch-ref-name" data-pitch-detector-target="refName" style="display: none;"></span>
      <span class="pitch-ref-status" data-pitch-detector-target="refStatus"></span>
    </div>

    <%# Guitar reference tones %>
    <div class="pitch-control-group">
      <label class="pitch-control-label">Reference Tones</label>
      <div class="pitch-guitar-btns">
        <% [['E2', 82.41], ['A2', 110.0], ['D3', 146.83], ['G3', 196.0], ['B3', 246.94], ['E4', 329.63]].each do |name, freq| %>
          <button class="pitch-ref-tone-btn btn-secondary"
                  data-freq="<%= freq %>"
                  data-action="click->pitch-detector#playGuitarString">
            <%= name %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

</div>

<style>
  .pitch-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.5rem 1rem 3rem;
  }

  .pitch-header { margin-bottom: 1.25rem; }
  .pitch-title {
    font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3rem);
    font-weight: 900;
    font-variation-settings: "CASL" 1;
    color: var(--ink);
    margin: 0 0 0.25rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .pitch-subtitle { color: var(--ink-2); font-size: 0.95rem; margin: 0; }

  /* Start button: presses down like .button on the public pages */
  .pitch-start-container { margin-bottom: 1.25rem; }
  .pitch-start-btn {
    padding: 0.7rem 1.5rem; border-radius: var(--radius);
    display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
    border: none; font: inherit; font-size: 1.05rem; font-weight: 800;
    font-variation-settings: "CASL" 0.8;
    background: var(--brand); color: var(--ground);
    box-shadow: 0 0.25rem 0 var(--shade);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .pitch-start-btn:hover { transform: translateY(-0.1rem) rotate(-1deg); box-shadow: 0 0.35rem 0 var(--shade); }
  .pitch-start-btn:active { transform: translateY(0.2rem); box-shadow: 0 0.05rem 0 var(--shade); }
  .pitch-start-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .pitch-start-btn .material-icons { font-size: 1.4rem; }
  .pitch-start-hint { margin-top: 0.6rem; font-size: 0.8rem; color: var(--ink-2); }

  .pitch-status { font-size: 0.85rem; margin-bottom: 0.75rem; min-height: 1.2em; }

  /* Info bar */
  .pitch-info-bar {
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .pitch-info-note { display: flex; align-items: baseline; gap: 0.5rem; }
  .pitch-note-display {
    font-size: 2.5rem; font-weight: 900; letter-spacing: -0.03em;
    line-height: 1; color: var(--ink-2); transition: color 0.1s ease;
    font-variation-settings: "MONO" 1;
    font-variant-numeric: tabular-nums;
  }
  .pitch-freq-display {
    font-size: 0.85rem; color: var(--ink-2);
    font-variation-settings: "MONO" 1; font-variant-numeric: tabular-nums;
  }

  .pitch-info-cents { flex: 1; min-width: 180px; }
  .pitch-cents-track { position: relative; }
  .pitch-cents-labels {
    display: flex; justify-content: space-between;
    font-size: 0.6rem; color: var(--ink-3); margin-bottom: 2px;
    font-variation-settings: "MONO" 1;
    user-select: none;
  }
  .pitch-cents-center-label { color: var(--brand); font-weight: 700; }
  .pitch-cents-bar {
    position: relative; height: 20px;
    background: var(--sunken); border-radius: 4px;
    border: 1px solid var(--line);
  }
  .pitch-cents-zone-green {
    position: absolute; left: 45%; right: 45%; top: 0; bottom: 0;
    background: color-mix(in srgb, var(--brand) 18%, transparent); border-radius: 4px;
  }
  .pitch-cents-needle {
    position: absolute; top: 2px; bottom: 2px; width: 4px; left: 50%;
    transform: translateX(-50%); border-radius: 2px;
    background: var(--brand);
    transition: left 0.06s ease-out;
  }
  .pitch-cents-value {
    font-size: 0.8rem; font-weight: 600; text-align: right;
    font-variation-settings: "MONO" 1; font-variant-numeric: tabular-nums;
    color: var(--ink-2); margin-top: 2px;
  }

  .pitch-info-level { display: flex; align-items: center; gap: 0.4rem; min-width: 100px; }
  .pitch-level-icon { font-size: 1rem; color: var(--ink-2); }
  .pitch-level-meter {
    flex: 1; height: 6px; background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: 3px; overflow: hidden;
  }
  .pitch-level-fill {
    height: 100%; width: 0%; background: var(--ink-2);
    border-radius: 3px; transition: width 0.05s linear;
  }

  .pitch-guitar-info {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.6rem; border-radius: 0.4rem;
    background: var(--ground-3); border: 1px solid var(--line);
  }
  .guitar-string-badge {
    font-size: 0.9rem; font-weight: 700; color: var(--ink);
    font-variation-settings: "MONO" 1;
    padding: 0.1rem 0.4rem; border: 2px solid var(--ink-2);
    border-radius: 0.3rem; transition: border-color 0.1s ease;
  }
  .guitar-cents { font-size: 0.8rem; font-variation-settings: "MONO" 1; font-variant-numeric: tabular-nums; }

  /* Grid section (the main visualization) */
  .pitch-grid-section {
    padding: 0.75rem;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .pitch-grid-header {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem; padding: 0 0.25rem;
  }
  .pitch-grid-legend {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.75rem; color: var(--ink-2); white-space: nowrap;
  }
  .pitch-legend-dot {
    width: 8px; height: 8px; border-radius: 50%; display: inline-block;
  }
  .pitch-legend-live { background: var(--brand); }
  .pitch-legend-ref { background: var(--plum); }
  .pitch-grid-hint { font-size: 0.7rem; color: var(--ink-3); }

  .pitch-grid-container {
    display: flex;
    height: 420px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--sunken);
  }

  /* Vertical piano keys */
  .pitch-piano-keys {
    width: 48px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--sunken);
    border-right: 1px solid var(--line);
    overflow: hidden;
  }

  .vkey {
    flex: 1;
    min-height: 0;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 4px;
    transition: background 0.08s ease;
    position: relative;
  }
  .vkey:focus { outline: none; }

  .vkey-white {
    background: var(--ground-3);
    border-bottom: 1px solid var(--ground-2);
  }
  .vkey-white:hover { background: var(--line); }

  .vkey-black {
    background: var(--sunken);
    border-bottom: 1px solid var(--ground);
  }
  .vkey-black:hover { background: var(--ground-2); }

  .vkey-label {
    font-size: 0.5rem;
    font-variation-settings: "MONO" 1;
    color: var(--ink-3);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    line-height: 1;
  }

  /* Canvas */
  .pitch-canvas-wrap {
    flex: 1;
    position: relative;
    min-width: 0;
  }
  .pitch-grid-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }

  /* Controls */
  .pitch-controls {
    padding: 1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: flex-start;
  }
  .pitch-control-group { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }

  /* Tape labels, like .label on the public pages */
  .pitch-control-label {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--sun); color: var(--ground);
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.04em;
    text-transform: uppercase; line-height: 1.2;
    padding: 0.15rem 0.45rem; border-radius: 0.25rem;
    transform: rotate(-1.5deg);
    font-variation-settings: "CASL" 1;
  }
  .pitch-gate-val { font-variation-settings: "MONO" 1; font-variant-numeric: tabular-nums; }

  .pitch-mode-toggle {
    position: relative; display: inline-flex;
    background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: 0.5rem; padding: 0; cursor: pointer; overflow: hidden;
  }
  .pitch-mode-option {
    flex: 1 1 0; text-align: center;
    padding: 0.4rem 0.75rem; font-size: 0.8rem; font-weight: 700;
    color: var(--ink-2); position: relative; z-index: 1;
    transition: color 0.2s ease; user-select: none;
  }
  .pitch-mode-toggle[aria-checked="false"] .pitch-mode-option:first-child,
  .pitch-mode-toggle[aria-checked="true"] .pitch-mode-option:last-child {
    color: var(--ground);
  }
  .pitch-mode-slider {
    position: absolute; top: 2px; bottom: 2px; left: 2px;
    width: calc(50% - 2px); background: var(--brand);
    border-radius: 0.375rem; transition: transform 0.2s ease; pointer-events: none;
  }
  .pitch-mode-toggle[aria-checked="true"] .pitch-mode-slider {
    transform: translateX(100%);
  }
  .pitch-mode-toggle:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .pitch-mode-label { display: none; }

  .pitch-slider {
    -webkit-appearance: none; appearance: none;
    width: 120px; height: 4px; background: var(--line);
    border-radius: 2px; outline: none;
  }
  .pitch-slider::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--brand); cursor: pointer; border: 2px solid var(--ground);
  }
  .pitch-slider::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--brand); cursor: pointer; border: 2px solid var(--ground);
  }
  .pitch-slider:focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; }

  /* Small press-down buttons: load, play, stop and the reference tones */
  .pitch-ref-group { min-width: 200px; }
  .pitch-ref-controls { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .pitch-ref-btn,
  .pitch-ref-stop-btn,
  .pitch-ref-tone-btn {
    font: inherit; font-size: 0.8rem; font-weight: 700;
    font-variation-settings: "CASL" 0.6;
    padding: 0.35rem 0.7rem; border-radius: var(--radius);
    display: inline-flex; align-items: center; justify-content: center; gap: 0.3rem;
    cursor: pointer; border: none;
    background: var(--ground-3); color: var(--ink);
    box-shadow: 0 0.25rem 0 var(--shade);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .pitch-ref-btn.btn-primary { background: var(--brand); color: var(--ground); }
  .pitch-ref-stop-btn { background: var(--clay); color: var(--ground); }
  .pitch-ref-tone-btn { min-width: 2.4rem; font-variation-settings: "MONO" 1; }
  .pitch-ref-btn:hover,
  .pitch-ref-stop-btn:hover,
  .pitch-ref-tone-btn:hover { transform: translateY(-0.1rem) rotate(-1deg); }
  .pitch-ref-btn:active,
  .pitch-ref-stop-btn:active,
  .pitch-ref-tone-btn:active { transform: translateY(0.2rem); box-shadow: 0 0.05rem 0 var(--shade); }
  .pitch-ref-btn:focus-visible,
  .pitch-ref-stop-btn:focus-visible,
  .pitch-ref-tone-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .pitch-ref-btn .material-icons { font-size: 1rem; }
  .pitch-ref-clear-btn {
    background: none; border: none; color: var(--ink-2); cursor: pointer;
    padding: 0.2rem; border-radius: 50%; display: inline-flex; align-items: center;
  }
  .pitch-ref-clear-btn:hover { color: var(--clay); background: var(--ground-3); }
  .pitch-ref-clear-btn .material-icons { font-size: 1rem; }
  .pitch-ref-name {
    font-size: 0.75rem; color: var(--ink-2); font-style: italic;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px;
  }
  .pitch-ref-status { font-size: 0.75rem; }

  .pitch-guitar-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* Responsive */
  @media (max-width: 640px) {
    .pitch-page { padding: 0.5rem 0.5rem 2rem; }
    .pitch-info-bar { padding: 0.75rem; gap: 0.75rem; }
    .pitch-note-display { font-size: 2rem; }
    .pitch-grid-container { height: 320px; }
    .pitch-piano-keys { width: 36px; }
    .vkey-label { font-size: 0.4rem; }
    .pitch-controls { padding: 0.75rem; gap: 0.75rem; }
    .pitch-info-cents { min-width: 140px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pitch-page * { transition: none !important; }
    .pitch-page button:hover { transform: none; }
    .pitch-control-label { transform: none; }
  }
</style>
