<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% @pages.each do |path, priority| %>
  <url>
    <loc>https://austn.net<%= path %></loc>
    <priority><%= priority %></priority>
  </url>
  <% end %>
  <% @work_items.each do |item| %>
  <url>
    <loc>https://austn.net<%= work_item_path(item) %></loc>
    <priority><%= item.featured? ? "0.8" : "0.6" %></priority>
  </url>
  <% end %>
  <% @playground_items.each do |item| %>
  <url>
    <loc>https://austn.net<%= playground_item_path(item) %></loc>
    <priority>0.5</priority>
  </url>
  <% end %>
  <% @blog_posts.each do |post| %>
  <url>
    <loc>https://austn.net<%= blog_post_path(post.slug) %></loc>
    <lastmod><%= post.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <priority>0.6</priority>
  </url>
  <% end %>
</urlset>
