<% page_title "Resume" %>
<% page_description "Austin French's resume: Tenex, Backlit, CompanyCam, CoverMyMeds. #{@resume.title}, New York." %>

<% content_for :wide, true %>

<%# On the web the PDF button and contact sit in the rail. In print the rail is
    hidden and the contact list below the name is shown instead. %>
<div class="page-grid">
  <header class="resume-header">
    <div>
      <h1><%= Profile.full_name %></h1>
      <p class="eyebrow"><%= @resume.title %> · <%= @resume.location %></p>
    </div>
  </header>

  <ul class="resume-contact print-only">
    <li><%= @resume.email %></li>
    <% @resume.links.each do |link| %>
      <li><%= link["url"].delete_prefix("https://") %></li>
    <% end %>
  </ul>

  <aside class="rail no-print">
    <%= link_to "Download PDF", resume_path(format: :pdf), class: "button" %>
    <p class="rail-title">Contact</p>
    <ul>
      <li><%= mail_to @resume.email %></li>
      <% @resume.links.each do |link| %>
        <li><%= link_to link["label"], link["url"] %></li>
      <% end %>
    </ul>
    <p class="rail-title">Looking for</p>
    <p class="muted" style="margin: 0 0 1.5rem;">Forward deployed, AI engineering, or senior product engineering. <%= link_to "Grab a time", book_path %> if that's you.</p>
    <p class="rail-title">Case studies</p>
    <ul>
      <% WorkItem.of_kind("job").each do |item| %>
        <li><%= link_to item.title, work_item_path(item) %></li>
      <% end %>
    </ul>
  </aside>

<h2>Summary</h2>
<p><%= @resume.summary %></p>

<h2>Experience</h2>
<% @resume.experience.each do |job| %>
  <section class="job">
    <div class="job-head">
      <h3><%= link_to job["company"], job["url"] %> · <%= job["title"] %></h3>
      <span class="meta"><%= job["dates"] %> · <%= job["location"] %></span>
    </div>
    <% if job["note"] %><p class="job-note"><%= job["note"] %></p><% end %>
    <% if job["about"] %><p class="muted"><%= job["about"] %></p><% end %>
    <ul>
      <% job["bullets"].each do |bullet| %>
        <li><% if bullet["lead"] %><strong><%= bullet["lead"] %></strong> <% end %><%= bullet["text"] %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<h2>Projects</h2>
<% @resume.projects.each do |project| %>
  <p><strong><%= project["name"] %></strong> <span class="meta">(<%= project["dates"] %>)</span> <%= project["text"] %></p>
<% end %>

<h2>Skills</h2>
<dl class="skills">
  <% @resume.skills.each do |skill| %>
    <dt><%= skill["label"] %></dt>
    <dd><%= skill["text"] %></dd>
  <% end %>
</dl>
</div>
