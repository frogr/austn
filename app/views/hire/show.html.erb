<% page_title "Hire me" %>
<% page_description "Fixed-scope AI projects from Austin French: custom MCP servers, RAG and agent builds, and a one-week eval setup sprint. Each ships with tests and the numbers." %>
<% content_for :wide, true %>

<div class="page-grid">
  <h1>Hire me</h1>
  <p class="lede">I take small, fixed-scope AI projects: MCP servers, RAG, agents and evals. Each one ships with tests, the numbers, and a plain list of what wasn't verified.</p>

  <aside class="rail">
    <p class="rail-title">Start here</p>
    <%= link_to "Book a 30-minute call", book_path, class: "button" %>
    <p class="muted">Or email <%= mail_to Profile.email %> with what you have in mind. You get a written scope, price and date before any work starts.</p>
    <p class="rail-title">Offers</p>
    <ul>
      <% @offers.each do |offer| %>
        <li><a href="#<%= offer.slug %>"><%= offer.title %></a></li>
      <% end %>
      <li><a href="#how-i-work">How I work</a></li>
    </ul>
    <p class="rail-title">Background</p>
    <p class="muted">Eight years of production engineering, mostly Rails and TypeScript, lately a lot of applied AI. The <%= link_to "resume", resume_path %> has the details.</p>
  </aside>

  <% @offers.each do |offer| %>
    <section class="offer" id="<%= offer.slug %>" aria-labelledby="<%= offer.slug %>-title">
      <h2 id="<%= offer.slug %>-title"><%= offer.title %></h2>
      <p><%= offer.summary %></p>

      <% if offer.tiers.any? %>
        <ul class="stats">
          <% offer.tiers.each_with_index do |tier, index| %>
            <li style="--i: <%= index %>">
              <strong><%= offer.dollars(tier["price"]) %></strong>
              <span><b><%= tier["name"] %></b>, <%= pluralize(tier["days"], "day") %>. <%= tier["includes"] %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <dl class="facts">
        <% if offer.tiers.empty? %>
          <dt>price</dt><dd class="offer-price"><%= offer.price_label %></dd>
          <% if offer.duration %><dt>time</dt><dd><%= offer.duration %></dd><% end %>
        <% end %>
        <% if offer.includes %><dt>you get</dt><dd><%= offer.includes %></dd><% end %>
        <dt>proof</dt>
        <dd class="offer-proof">
          <%= safe_join(offer.proof.map { |item| link_to(item.title, work_item_path(item)) }, ", ") %><% if offer.course_slug %>, and my course, <%= link_to Course.find(offer.course_slug).title, course_path(offer.course_slug) %><% end %>
        </dd>
      </dl>
    </section>
  <% end %>

  <section id="how-i-work" aria-labelledby="how-i-work-title">
    <h2 id="how-i-work-title">How I work</h2>
    <% @how_i_work.each do |point| %>
      <h3><%= point["title"] %></h3>
      <p><%= point["text"] %></p>
    <% end %>
  </section>

  <h2>Next step</h2>
  <p>Tell me what you're building and what's in the way. <%= link_to "Book a 30-minute call", book_path %> or <%= mail_to Profile.email, "email me" %>.</p>
</div>
