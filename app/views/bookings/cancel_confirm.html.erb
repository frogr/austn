<% page_title "Cancel booking" %>

<h1>Cancel this booking?</h1>

<dl class="facts">
  <dt>date</dt><dd><%= @booking.formatted_date %></dd>
  <dt>time</dt><dd><%= @booking.formatted_time_range %></dd>
</dl>

<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
  <%= button_to "Yes, cancel it", cancel_booking_path(@booking.confirmation_token), method: :delete, class: "button" %>
  <%= link_to "Keep it", confirmation_booking_path(@booking.confirmation_token), class: "button button--quiet" %>
</div>
