<% page_title "You're booked" %>

<h1>You're booked</h1>
<p class="lede">A confirmation with a calendar invite is on its way to <strong><%= @booking.email %></strong>.</p>

<dl class="facts">
  <dt>date</dt><dd><%= @booking.formatted_date %></dd>
  <dt>time</dt><dd><%= @booking.formatted_time_range %></dd>
  <% if @booking.notes.present? %><dt>notes</dt><dd><%= @booking.notes %></dd><% end %>
</dl>

<p>Need to cancel? <%= link_to "Cancel this booking", cancel_confirm_booking_path(@booking.confirmation_token) %>.</p>
<p><%= link_to "Back to austn.net", root_path %></p>
