<% page_title "Book a time" %>
<% page_description "Pick a time to talk with Austin French. 30-minute calls, Eastern time." %>

<h1>Book a time</h1>
<p class="lede">Pick a day, then a time. Calls are 30 minutes, and times are Eastern.</p>

<% if @nothing_open %>
  <p class="note">No open times right now. Email <%= mail_to Profile.email %> and I'll find one.</p>
<% else %>
  <nav class="pager" aria-label="Month" style="margin: 2rem 0 1rem;">
    <%= link_to "← #{(@current_month - 1.month).strftime("%B")}", book_path(month: (@current_month - 1.month).strftime("%Y-%m")), "aria-label": "Previous month" %>
    <strong><%= @current_month.strftime("%B %Y") %></strong>
    <%= link_to "#{(@current_month + 1.month).strftime("%B")} →", book_path(month: (@current_month + 1.month).strftime("%Y-%m")), "aria-label": "Next month" %>
  </nav>

  <table class="cal">
    <thead>
      <tr><% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %><th scope="col"><%= day %></th><% end %></tr>
    </thead>
    <tbody>
      <% days = Array.new(@current_month.wday) + (@current_month..@current_month.end_of_month).to_a %>
      <% days.each_slice(7) do |week| %>
        <tr>
          <% week.each do |date| %>
            <td>
              <% if date.nil? %>
              <% elsif @available_dates.include?(date) %>
                <%= link_to date.day, book_date_path(date: date.to_s), "aria-label": date.strftime("%A, %B %-d, open") %>
              <% else %>
                <span aria-hidden="true"><%= date.day %></span>
              <% end %>
            </td>
          <% end %>
          <% (7 - week.size).times do %><td></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @available_dates.empty? %>
    <p class="muted">Nothing open this month. Try next month, or email <%= mail_to Profile.email %>.</p>
  <% end %>
<% end %>
