<% page_title "Book a time" %>

<%= link_to "← Back to the calendar", book_path(month: @date.strftime("%Y-%m")), class: "back" %>

<h1><%= @date.strftime("%A, %B %-d") %></h1>

<% if @slot_error.present? %>
  <p class="note"><%= @slot_error %></p>
<% elsif @slots.empty? %>
  <p class="note">Nothing open on this day. <%= link_to "Pick another day", book_path %>, or email <%= mail_to Profile.email %>.</p>
<% else %>
  <%= form_with url: bookings_path, method: :post, data: { turbo: false } do %>
    <input type="hidden" name="booked_date" value="<%= @date.to_s %>">

    <fieldset style="border: 0; padding: 0; margin: 0 0 1.5rem;">
      <legend class="muted" style="margin-bottom: 0.75rem;">Pick a time (Eastern)</legend>
      <ul class="slots">
        <% @slots.each_with_index do |slot, index| %>
          <li>
            <input type="radio" name="start_time" id="slot-<%= index %>" value="<%= slot.start_label %>" required <%= "checked" if params[:start_time] == slot.start_label %>>
            <label for="slot-<%= index %>"><%= slot.starts_at.strftime("%-l:%M %p") %></label>
          </li>
        <% end %>
      </ul>
    </fieldset>

    <label class="field"><span>First name</span><input type="text" name="first_name" required autocomplete="given-name" value="<%= params[:first_name] %>"></label>
    <label class="field"><span>Email</span><input type="email" name="email" required autocomplete="email" value="<%= params[:email] %>"></label>
    <label class="field"><span>Phone (in case the call link fails)</span><input type="tel" name="phone_number" required autocomplete="tel" value="<%= params[:phone_number] %>"></label>
    <label class="field"><span>What do you want to talk about? (optional)</span><textarea name="notes" rows="3"><%= params[:notes] %></textarea></label>

    <button type="submit" class="button">Book it</button>
  <% end %>
<% end %>
